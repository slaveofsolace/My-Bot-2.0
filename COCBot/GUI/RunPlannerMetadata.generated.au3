	$g_aRunPlannerSettings[18][$eRunPlannerSettingLabel] = "Give up after"
	$g_aRunPlannerSettings[18][$eRunPlannerSettingSummary] = "Stop searching once this long has passed."
	$g_aRunPlannerSettings[18][$eRunPlannerSettingDescription] = "A long search costs a Gold search fee each skip. This caps how long the run will hunt before taking what it can find. Zero means no cap."
