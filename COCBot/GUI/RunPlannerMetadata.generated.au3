	$g_aRunPlannerSettings[18][$eRunPlannerSettingNativeFixedValue] = 0
	$g_aRunPlannerSettings[18][$eRunPlannerSettingNativeFixedReason] = "The inherited search loop has no safe elapsed-time exit, so this value must remain zero."
