	$g_aRunPlannerSettings[15][$eRunPlannerSettingSectionId] = "search"
	$g_aRunPlannerSettings[15][$eRunPlannerSettingType] = "select"
	$g_aRunPlannerSettings[15][$eRunPlannerSettingLabel] = "Town Hall filter"
	$g_aRunPlannerSettings[15][$eRunPlannerSettingSummary] = "Which defender Town Hall levels to accept."
	$g_aRunPlannerSettings[15][$eRunPlannerSettingDescription] = "Filtering by defender Town Hall needs the bot to read the Town Hall on the search screen, which changed with Town Hall 18."
	$g_aRunPlannerSettings[15][$eRunPlannerSettingDefault] = "any"
	$g_aRunPlannerSettings[15][$eRunPlannerSettingRequired] = True
	$g_aRunPlannerSettings[15][$eRunPlannerSettingBinding] = "RunPlan.search_town_hall_filter"
