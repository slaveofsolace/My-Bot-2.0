	$g_aRunPlannerSettings[16][$eRunPlannerSettingStep] = 15
	$g_aRunPlannerSettings[16][$eRunPlannerSettingEmptyState] = ""
	$g_aRunPlannerSettings[16][$eRunPlannerSettingNativeFixed] = True
	$g_aRunPlannerSettings[16][$eRunPlannerSettingNativeFixedValue] = 0
	$g_aRunPlannerSettings[16][$eRunPlannerSettingNativeFixedReason] = "The inherited search loop has no safe elapsed-time exit, so this value must remain zero."
