	$g_aRunPlannerSettings[14][$eRunPlannerSettingSectionId] = "search"
	$g_aRunPlannerSettings[14][$eRunPlannerSettingType] = "integer"
	$g_aRunPlannerSettings[14][$eRunPlannerSettingLabel] = "Give up after"
	$g_aRunPlannerSettings[14][$eRunPlannerSettingSummary] = "Stop searching once this long has passed."
	$g_aRunPlannerSettings[14][$eRunPlannerSettingDescription] = "A long search costs a Gold search fee each skip. This caps how long the run will hunt before taking what it can find. Zero means no cap."
	$g_aRunPlannerSettings[14][$eRunPlannerSettingDefault] = 0
	$g_aRunPlannerSettings[14][$eRunPlannerSettingRequired] = False
	$g_aRunPlannerSettings[14][$eRunPlannerSettingBinding] = "RunPlan.search_max_seconds"
