	$g_aRunPlannerSettings[24][$eRunPlannerSettingLabel] = "Rest for"
	$g_aRunPlannerSettings[24][$eRunPlannerSettingSummary] = "How long each scheduled pause lasts. Ignored when rests are off."
	$g_aRunPlannerSettings[24][$eRunPlannerSettingDescription] = "The run stops issuing actions for this long and then picks up where it left off. Time spent resting still counts against the run duration limit, so a long rest on a short run can end it before the next battle."
	$g_aRunPlannerSettings[24][$eRunPlannerSettingDefault] = 5
