	$g_aRunPlannerOptions[11][$eRunPlannerOptionSummary] = "Request Clan Castle reinforcements once, without donating or matchmaking."
	$g_aRunPlannerOptions[11][$eRunPlannerOptionDescription] = "Runs one bounded request-only pass on the exact active profile and emulator instance. It requires a fresh Available button, permits one Send, proves the fresh transition to AlreadyMade, re-proves Home Village, then stops. It never enters donation, army editing, training, collectors, upgrades, events, account rotation, or battle paths."
	$g_aRunPlannerOptions[11][$eRunPlannerOptionAvailability] = "gated"
