	$g_aRunPlannerOptions[9][$eRunPlannerOptionValue] = "smart.local"
	$g_aRunPlannerOptions[9][$eRunPlannerOptionLabel] = "Smart Attack (research-guided)"
	$g_aRunPlannerOptions[9][$eRunPlannerOptionSummary] = "Concentrates the current army using a Town Hall-aware local policy."
	$g_aRunPlannerOptions[9][$eRunPlannerOptionDescription] = "The deterministic Town Hall policy is versioned in config/game/smart-attack-strategies.json and executed locally. One older-binary bounded supervised TH17 run observed three zoom gestures, 240 red-line points, deterministic BL-side selection, 23-to-zero troop deployment, four selected Hero phase commands, Rage 3-to-zero, one Freeze decrement, and an automatic one-battle stop. The current reviewed local package passed install, repeated exact-current no-input managed-engine checks, and bot-owned BlueStacks and game launch with passive Home proof. Those orchestration checks do not verify managed Start, current-client gameplay, fixtures, live human review, strategy quality, or every Town Hall and army."
	$g_aRunPlannerOptions[9][$eRunPlannerOptionAvailability] = "unsupported"
	$g_aRunPlannerOptions[9][$eRunPlannerOptionDisabledReason] = "Battle execution is disabled: exact-current supervised readiness reached inherited ImgLoc, which rejected this fork before matchmaking. Diagnostic acknowledgement cannot bypass the licensing boundary."
