	$g_aRunPlannerSettings[17][$eRunPlannerSettingNativeFixedReason] = ""
	$g_aRunPlannerSettings[18][$eRunPlannerSettingId] = "pacing.action_delay_ms"
	$g_aRunPlannerSettings[18][$eRunPlannerSettingSectionId] = "pacing"
	$g_aRunPlannerSettings[18][$eRunPlannerSettingType] = "integer"
	$g_aRunPlannerSettings[18][$eRunPlannerSettingLabel] = "Gap between actions"
	$g_aRunPlannerSettings[18][$eRunPlannerSettingSummary] = "Shortest wait between two taps. Zero drives the emulator as fast as it answers."
	$g_aRunPlannerSettings[18][$eRunPlannerSettingDescription] = "The bot can issue taps faster than an emulator redraws, and an action sent into a screen that has not finished changing lands on whatever was underneath it. This sets a floor on the gap between one action and the next. The wait is only taken when the previous action finished more recently than this, so a slow step costs nothing extra."
	$g_aRunPlannerSettings[18][$eRunPlannerSettingDefault] = 120
	$g_aRunPlannerSettings[18][$eRunPlannerSettingRequired] = False
	$g_aRunPlannerSettings[18][$eRunPlannerSettingBinding] = "RunPacing.action_delay_ms"
	$g_aRunPlannerSettings[18][$eRunPlannerSettingUnit] = "milliseconds"
	$g_aRunPlannerSettings[18][$eRunPlannerSettingMinimum] = 0
	$g_aRunPlannerSettings[18][$eRunPlannerSettingMaximum] = 5000
	$g_aRunPlannerSettings[18][$eRunPlannerSettingStep] = 10
	$g_aRunPlannerSettings[18][$eRunPlannerSettingEmptyState] = ""
	$g_aRunPlannerSettings[18][$eRunPlannerSettingNativeFixed] = False
	$g_aRunPlannerSettings[18][$eRunPlannerSettingNativeFixedValue] = ""
	$g_aRunPlannerSettings[18][$eRunPlannerSettingNativeFixedReason] = ""
	$g_aRunPlannerSettings[19][$eRunPlannerSettingId] = "pacing.settle_ms"
	$g_aRunPlannerSettings[19][$eRunPlannerSettingSectionId] = "pacing"
	$g_aRunPlannerSettings[19][$eRunPlannerSettingType] = "integer"
	$g_aRunPlannerSettings[19][$eRunPlannerSettingLabel] = "Screen settle wait"
	$g_aRunPlannerSettings[19][$eRunPlannerSettingSummary] = "How long to let a screen finish changing before reading it."
	$g_aRunPlannerSettings[19][$eRunPlannerSettingDescription] = "Applies after anything that starts an animation: opening a menu, dismissing a dialog, returning from a battle. Reading pixels while the frame is still moving is the largest single source of misidentified screens, and waiting here costs far less than acting on a wrong one."
	$g_aRunPlannerSettings[19][$eRunPlannerSettingDefault] = 400
	$g_aRunPlannerSettings[19][$eRunPlannerSettingRequired] = False
	$g_aRunPlannerSettings[19][$eRunPlannerSettingBinding] = "RunPacing.settle_ms"
	$g_aRunPlannerSettings[19][$eRunPlannerSettingUnit] = "milliseconds"
	$g_aRunPlannerSettings[19][$eRunPlannerSettingMinimum] = 0
	$g_aRunPlannerSettings[19][$eRunPlannerSettingMaximum] = 10000
	$g_aRunPlannerSettings[19][$eRunPlannerSettingStep] = 50
	$g_aRunPlannerSettings[19][$eRunPlannerSettingEmptyState] = ""
	$g_aRunPlannerSettings[19][$eRunPlannerSettingNativeFixed] = False
	$g_aRunPlannerSettings[19][$eRunPlannerSettingNativeFixedValue] = ""
	$g_aRunPlannerSettings[19][$eRunPlannerSettingNativeFixedReason] = ""
	$g_aRunPlannerSettings[20][$eRunPlannerSettingId] = "pacing.retry_attempts"
	$g_aRunPlannerSettings[20][$eRunPlannerSettingSectionId] = "pacing"
	$g_aRunPlannerSettings[20][$eRunPlannerSettingType] = "integer"
	$g_aRunPlannerSettings[20][$eRunPlannerSettingLabel] = "Retries per action"
	$g_aRunPlannerSettings[20][$eRunPlannerSettingSummary] = "Reserved for handlers that can prove a tap changed nothing."
	$g_aRunPlannerSettings[20][$eRunPlannerSettingDescription] = "Generic retries are unsafe without a visual-change observer: repeating a successful destructive tap can do the wrong thing twice. Keep this at zero until a screen-specific handler can prove the first action was dropped; Start rejects nonzero values instead of guessing."
	$g_aRunPlannerSettings[20][$eRunPlannerSettingDefault] = 0
	$g_aRunPlannerSettings[20][$eRunPlannerSettingRequired] = False
	$g_aRunPlannerSettings[20][$eRunPlannerSettingBinding] = "RunPacing.retry_attempts"
	$g_aRunPlannerSettings[20][$eRunPlannerSettingUnit] = "attempts"
	$g_aRunPlannerSettings[20][$eRunPlannerSettingMinimum] = 0
	$g_aRunPlannerSettings[20][$eRunPlannerSettingMaximum] = 10
	$g_aRunPlannerSettings[20][$eRunPlannerSettingStep] = 1
	$g_aRunPlannerSettings[20][$eRunPlannerSettingEmptyState] = ""
	$g_aRunPlannerSettings[20][$eRunPlannerSettingNativeFixed] = True
	$g_aRunPlannerSettings[20][$eRunPlannerSettingNativeFixedValue] = 0
	$g_aRunPlannerSettings[20][$eRunPlannerSettingNativeFixedReason] = "Generic retries have no visual-change observer in the native engine and must remain zero."
	$g_aRunPlannerSettings[21][$eRunPlannerSettingId] = "pacing.break_every_minutes"
	$g_aRunPlannerSettings[21][$eRunPlannerSettingSectionId] = "pacing"
	$g_aRunPlannerSettings[21][$eRunPlannerSettingType] = "integer"
	$g_aRunPlannerSettings[21][$eRunPlannerSettingLabel] = "Rest after"
	$g_aRunPlannerSettings[21][$eRunPlannerSettingSummary] = "Pause the run once it has been going this long. Zero never pauses."
	$g_aRunPlannerSettings[21][$eRunPlannerSettingDescription] = "Hours of unbroken emulator load is where thermal throttling and memory growth start showing up as misread screens. This schedules a pause so the machine gets a gap. The run resumes by itself afterwards; nothing is closed and no progress is lost."
	$g_aRunPlannerSettings[21][$eRunPlannerSettingDefault] = 0
	$g_aRunPlannerSettings[21][$eRunPlannerSettingRequired] = False
	$g_aRunPlannerSettings[21][$eRunPlannerSettingBinding] = "RunPacing.break_every_minutes"
	$g_aRunPlannerSettings[21][$eRunPlannerSettingUnit] = "minutes"
	$g_aRunPlannerSettings[21][$eRunPlannerSettingMinimum] = 0
	$g_aRunPlannerSettings[21][$eRunPlannerSettingMaximum] = 1440
	$g_aRunPlannerSettings[21][$eRunPlannerSettingStep] = 5
	$g_aRunPlannerSettings[21][$eRunPlannerSettingEmptyState] = ""
	$g_aRunPlannerSettings[21][$eRunPlannerSettingNativeFixed] = False
	$g_aRunPlannerSettings[21][$eRunPlannerSettingNativeFixedValue] = ""
	$g_aRunPlannerSettings[21][$eRunPlannerSettingNativeFixedReason] = ""
	$g_aRunPlannerSettings[22][$eRunPlannerSettingId] = "pacing.break_minutes"
	$g_aRunPlannerSettings[22][$eRunPlannerSettingSectionId] = "pacing"
	$g_aRunPlannerSettings[22][$eRunPlannerSettingType] = "integer"
	$g_aRunPlannerSettings[22][$eRunPlannerSettingLabel] = "Rest for"
	$g_aRunPlannerSettings[22][$eRunPlannerSettingSummary] = "How long each scheduled pause lasts. Ignored when rests are off."
	$g_aRunPlannerSettings[22][$eRunPlannerSettingDescription] = "The run stops issuing actions for this long and then picks up where it left off. Time spent resting still counts against the run duration limit, so a long rest on a short run can end it before the next battle."
	$g_aRunPlannerSettings[22][$eRunPlannerSettingDefault] = 5
	$g_aRunPlannerSettings[22][$eRunPlannerSettingRequired] = False
	$g_aRunPlannerSettings[22][$eRunPlannerSettingBinding] = "RunPacing.break_minutes"
