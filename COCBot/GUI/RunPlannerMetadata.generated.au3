	$g_aRunPlannerSettings[16][$eRunPlannerSettingId] = "search.max_seconds"
	$g_aRunPlannerSettings[16][$eRunPlannerSettingSectionId] = "search"
	$g_aRunPlannerSettings[16][$eRunPlannerSettingType] = "integer"
	$g_aRunPlannerSettings[16][$eRunPlannerSettingLabel] = "Give up after"
	$g_aRunPlannerSettings[16][$eRunPlannerSettingSummary] = "Stop searching once this long has passed."
	$g_aRunPlannerSettings[16][$eRunPlannerSettingDescription] = "A long search costs a Gold search fee each skip. This caps how long the run will hunt before taking what it can find. Zero means no cap."
	$g_aRunPlannerSettings[16][$eRunPlannerSettingDefault] = 0
	$g_aRunPlannerSettings[16][$eRunPlannerSettingRequired] = False
	$g_aRunPlannerSettings[16][$eRunPlannerSettingBinding] = "RunPlan.search_max_seconds"
