	$g_aRunPlannerSettings[20][$eRunPlannerSettingId] = "pacing.action_delay_ms"
	$g_aRunPlannerSettings[20][$eRunPlannerSettingSectionId] = "pacing"
	$g_aRunPlannerSettings[20][$eRunPlannerSettingType] = "integer"
	$g_aRunPlannerSettings[20][$eRunPlannerSettingLabel] = "Gap between actions"
	$g_aRunPlannerSettings[20][$eRunPlannerSettingSummary] = "Shortest wait between two taps. Zero drives the emulator as fast as it answers."
	$g_aRunPlannerSettings[20][$eRunPlannerSettingDescription] = "The bot can issue taps faster than an emulator redraws, and an action sent into a screen that has not finished changing lands on whatever was underneath it. This sets a floor on the gap between one action and the next. The wait is only taken when the previous action finished more recently than this, so a slow step costs nothing extra."
	$g_aRunPlannerSettings[20][$eRunPlannerSettingDefault] = 120
	$g_aRunPlannerSettings[20][$eRunPlannerSettingRequired] = False
	$g_aRunPlannerSettings[20][$eRunPlannerSettingBinding] = "RunPacing.action_delay_ms"
	$g_aRunPlannerSettings[20][$eRunPlannerSettingUnit] = "milliseconds"
	$g_aRunPlannerSettings[20][$eRunPlannerSettingMinimum] = 0
	$g_aRunPlannerSettings[20][$eRunPlannerSettingMaximum] = 5000
	$g_aRunPlannerSettings[20][$eRunPlannerSettingStep] = 10
	$g_aRunPlannerSettings[20][$eRunPlannerSettingEmptyState] = ""
	$g_aRunPlannerSettings[20][$eRunPlannerSettingNativeFixed] = False
	$g_aRunPlannerSettings[20][$eRunPlannerSettingNativeFixedValue] = ""
	$g_aRunPlannerSettings[20][$eRunPlannerSettingNativeFixedReason] = ""
	$g_aRunPlannerSettings[21][$eRunPlannerSettingId] = "pacing.settle_ms"
	$g_aRunPlannerSettings[21][$eRunPlannerSettingSectionId] = "pacing"
	$g_aRunPlannerSettings[21][$eRunPlannerSettingType] = "integer"
	$g_aRunPlannerSettings[21][$eRunPlannerSettingLabel] = "Screen settle wait"
	$g_aRunPlannerSettings[21][$eRunPlannerSettingSummary] = "How long to let a screen finish changing before reading it."
	$g_aRunPlannerSettings[21][$eRunPlannerSettingDescription] = "Applies after anything that starts an animation: opening a menu, dismissing a dialog, returning from a battle. Reading pixels while the frame is still moving is the largest single source of misidentified screens, and waiting here costs far less than acting on a wrong one."
	$g_aRunPlannerSettings[21][$eRunPlannerSettingDefault] = 400
	$g_aRunPlannerSettings[21][$eRunPlannerSettingRequired] = False
	$g_aRunPlannerSettings[21][$eRunPlannerSettingBinding] = "RunPacing.settle_ms"
	$g_aRunPlannerSettings[21][$eRunPlannerSettingUnit] = "milliseconds"
	$g_aRunPlannerSettings[21][$eRunPlannerSettingMinimum] = 0
	$g_aRunPlannerSettings[21][$eRunPlannerSettingMaximum] = 10000
	$g_aRunPlannerSettings[21][$eRunPlannerSettingStep] = 50
	$g_aRunPlannerSettings[21][$eRunPlannerSettingEmptyState] = ""
	$g_aRunPlannerSettings[21][$eRunPlannerSettingNativeFixed] = False
	$g_aRunPlannerSettings[21][$eRunPlannerSettingNativeFixedValue] = ""
	$g_aRunPlannerSettings[21][$eRunPlannerSettingNativeFixedReason] = ""
	$g_aRunPlannerSettings[22][$eRunPlannerSettingId] = "pacing.retry_attempts"
	$g_aRunPlannerSettings[22][$eRunPlannerSettingSectionId] = "pacing"
	$g_aRunPlannerSettings[22][$eRunPlannerSettingType] = "integer"
	$g_aRunPlannerSettings[22][$eRunPlannerSettingLabel] = "Retries per action"
	$g_aRunPlannerSettings[22][$eRunPlannerSettingSummary] = "Reserved for handlers that can prove a tap changed nothing."
	$g_aRunPlannerSettings[22][$eRunPlannerSettingDescription] = "Generic retries are unsafe without a visual-change observer: repeating a successful destructive tap can do the wrong thing twice. Keep this at zero until a screen-specific handler can prove the first action was dropped; Start rejects nonzero values instead of guessing."
	$g_aRunPlannerSettings[22][$eRunPlannerSettingDefault] = 0
	$g_aRunPlannerSettings[22][$eRunPlannerSettingRequired] = False
	$g_aRunPlannerSettings[22][$eRunPlannerSettingBinding] = "RunPacing.retry_attempts"
	$g_aRunPlannerSettings[22][$eRunPlannerSettingUnit] = "attempts"
	$g_aRunPlannerSettings[22][$eRunPlannerSettingMinimum] = 0
	$g_aRunPlannerSettings[22][$eRunPlannerSettingMaximum] = 10
	$g_aRunPlannerSettings[22][$eRunPlannerSettingStep] = 1
	$g_aRunPlannerSettings[22][$eRunPlannerSettingEmptyState] = ""
	$g_aRunPlannerSettings[22][$eRunPlannerSettingNativeFixed] = True
	$g_aRunPlannerSettings[22][$eRunPlannerSettingNativeFixedValue] = 0
	$g_aRunPlannerSettings[22][$eRunPlannerSettingNativeFixedReason] = "Generic retries have no visual-change observer in the native engine and must remain zero."
	$g_aRunPlannerSettings[23][$eRunPlannerSettingId] = "pacing.break_every_minutes"
	$g_aRunPlannerSettings[23][$eRunPlannerSettingSectionId] = "pacing"
	$g_aRunPlannerSettings[23][$eRunPlannerSettingType] = "integer"
	$g_aRunPlannerSettings[23][$eRunPlannerSettingLabel] = "Rest after"
	$g_aRunPlannerSettings[23][$eRunPlannerSettingSummary] = "Pause the run once it has been going this long. Zero never pauses."
	$g_aRunPlannerSettings[23][$eRunPlannerSettingDescription] = "Hours of unbroken emulator load is where thermal throttling and memory growth start showing up as misread screens. This schedules a pause so the machine gets a gap. The run resumes by itself afterwards; nothing is closed and no progress is lost."
	$g_aRunPlannerSettings[23][$eRunPlannerSettingDefault] = 0
	$g_aRunPlannerSettings[23][$eRunPlannerSettingRequired] = False
	$g_aRunPlannerSettings[23][$eRunPlannerSettingBinding] = "RunPacing.break_every_minutes"
	$g_aRunPlannerSettings[23][$eRunPlannerSettingUnit] = "minutes"
	$g_aRunPlannerSettings[23][$eRunPlannerSettingMinimum] = 0
	$g_aRunPlannerSettings[23][$eRunPlannerSettingMaximum] = 1440
	$g_aRunPlannerSettings[23][$eRunPlannerSettingStep] = 5
	$g_aRunPlannerSettings[23][$eRunPlannerSettingEmptyState] = ""
	$g_aRunPlannerSettings[23][$eRunPlannerSettingNativeFixed] = False
	$g_aRunPlannerSettings[23][$eRunPlannerSettingNativeFixedValue] = ""
	$g_aRunPlannerSettings[23][$eRunPlannerSettingNativeFixedReason] = ""
	$g_aRunPlannerSettings[24][$eRunPlannerSettingId] = "pacing.break_minutes"
	$g_aRunPlannerSettings[24][$eRunPlannerSettingSectionId] = "pacing"
