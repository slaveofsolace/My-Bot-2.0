	$g_aRunPlannerSettings[17][$eRunPlannerSettingSummary] = "Which defender Town Hall levels to accept."
	$g_aRunPlannerSettings[17][$eRunPlannerSettingDescription] = "Filtering by defender Town Hall needs the bot to read the Town Hall on the search screen, which changed with Town Hall 18."
