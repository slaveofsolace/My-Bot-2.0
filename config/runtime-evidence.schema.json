{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/my-bot-2.0/runtime-evidence.schema.json",
  "title": "My Bot 2.0 runtime evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "capability_id",
    "test_type",
    "result",
    "captured_at",
    "commit_sha",
    "redacted",
    "environment",
    "checks",
    "reviewer",
    "artifact_refs",
    "notes"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "evidence_id": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
    "capability_id": {"type": "string", "minLength": 3, "maxLength": 128},
    "test_type": {"enum": ["windows-static", "emulator-smoke", "game-surface-recognition", "route-execution", "end-to-end"]},
    "result": {"enum": ["passed", "failed", "blocked"]},
    "captured_at": {"type": "string", "format": "date-time"},
    "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "redacted": {"const": true},
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "os_version", "autoit_version", "emulator", "emulator_version", "instance_index", "game_version"],
      "properties": {
        "os": {"type": "string", "minLength": 2, "maxLength": 80},
        "os_version": {"type": "string", "minLength": 1, "maxLength": 80},
        "autoit_version": {"type": "string", "maxLength": 32},
        "emulator": {"type": "string", "maxLength": 80},
        "emulator_version": {"type": "string", "maxLength": 80},
        "instance_index": {"type": "integer", "minimum": 0, "maximum": 1000},
        "game_version": {"type": "string", "maxLength": 80}
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "result", "details"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
          "result": {"enum": ["passed", "failed", "blocked"]},
          "details": {"type": "string", "minLength": 5, "maxLength": 2000}
        }
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "reviewed_at"],
      "properties": {
        "name": {"type": "string", "maxLength": 128},
        "reviewed_at": {"type": "string", "maxLength": 64}
      }
    },
    "artifact_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 3, "maxLength": 300},
      "uniqueItems": true
    },
    "notes": {"type": "string", "maxLength": 4000}
  }
}
