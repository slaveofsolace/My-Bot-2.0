  "status_definitions": {
    "catalogued": "The official change and affected subsystems are documented, but recognition and execution are not implemented.",
    "adapter-added": "Source integration is present and statically verified; controlled Windows runtime testing remains required.",
    "engine-added": "A reusable engine contract is implemented and statically verified; runtime evidence remains required before support promotion.",
    "legacy-implemented": "An inherited native execution path exists, but current-client recognition and end-to-end behavior remain unverified.",
    "fixture-required": "Recognition cannot be claimed until dated, approved screenshots are available.",
    "supported": "Automated fixtures and controlled runtime evidence both pass and the promotion was reviewed."
  },
  "runtime_evidence_policy": {
