{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/my-bot-2.0/run-event.schema.json",
  "title": "My Bot 2.0 run event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sequence",
    "type",
    "severity",
    "session_id",
    "timestamp_ms",
    "message",
    "account_profile_id",
    "route",
    "battle_index",
    "gold",
    "elixir",
    "dark_elixir",
    "stars",
    "destruction_percent",
    "trophy_delta",
    "search_count",
    "failure_count",
    "verification_state",
    "surface_id"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "sequence": {"type": "integer", "minimum": 0},
    "type": {
      "enum": [
        "plan.loaded",
        "session.preparing",
        "session.started",
        "session.stopping",
        "session.completed",
        "session.failed",
        "engine.check.started",
        "engine.check.passed",
        "engine.check.cancelled",
        "engine.check.failed",
        "route.blocked",
        "route.ready",
        "route.diagnostic",
        "account.changed",
        "battle.started",
        "battle.completed",
        "battle.failed",
        "combat.decision",
        "combat.zoom-verified",
        "combat.deployment-verified",
        "combat.hero-ability",
        "combat.spell-command",
        "combat.spell-cast",
        "combat.spell-unconfirmed",
        "combat.spell-retained",
        "maintenance.collectors.started",
        "maintenance.home-verified",
        "maintenance.collectors.completed",
        "maintenance.collectors.none-actionable",
        "maintenance.daily-reward.started",
        "maintenance.daily-reward.claim-issued",
        "maintenance.daily-reward.unavailable",
        "maintenance.daily-reward.unconfirmed",
        "maintenance.loot-cart.started",
        "maintenance.loot-cart.open-issued",
        "maintenance.loot-cart.collect-issued",
        "maintenance.loot-cart.unavailable",
        "maintenance.loot-cart.unconfirmed",
        "maintenance.loot-cart.home-verified",
        "maintenance.treasury.started",
        "maintenance.treasury.castle-issued",
        "maintenance.treasury.entry-issued",
        "maintenance.treasury.collect-issued",
        "maintenance.treasury.confirm-issued",
        "maintenance.treasury.close-issued",
        "maintenance.treasury.unavailable",
        "maintenance.treasury.unconfirmed",
        "maintenance.treasury.home-verified",
        "maintenance.clan-request.started",
        "maintenance.clan-request.unavailable",
        "maintenance.clan-request.unconfirmed",
        "maintenance.clan-request.committed",
        "maintenance.clan-request.home-verified",
        "loot.updated",
        "quota.observed",
        "quota.exhausted",
        "pacing.rest.started",
        "pacing.rest.ended",
        "warning",
        "error"
      ]
    },
    "severity": {"enum": ["debug", "info", "warning", "error"]},
    "session_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "timestamp_ms": {"type": "integer", "minimum": 0},
    "message": {"type": "string", "maxLength": 2048},
    "account_profile_id": {"type": "string", "maxLength": 64},
    "route": {"enum": ["", "regular", "ranked", "legend", "builder"]},
    "battle_index": {"type": "integer", "minimum": 0},
    "gold": {"type": "integer", "minimum": 0},
    "elixir": {"type": "integer", "minimum": 0},
    "dark_elixir": {"type": "integer", "minimum": 0},
    "stars": {"type": "integer", "minimum": 0, "maximum": 3},
    "destruction_percent": {"type": "integer", "minimum": 0, "maximum": 100},
    "trophy_delta": {"type": "integer"},
    "search_count": {"type": "integer", "minimum": 0},
    "failure_count": {"type": "integer", "minimum": 0},
    "verification_state": {"enum": ["verified", "unverified-diagnostic"]},
    "surface_id": {"type": "string", "maxLength": 64}
  }
}
