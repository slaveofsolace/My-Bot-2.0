{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/my-bot-2.0/ui/settings.schema.json",
  "title": "My Bot 2.0 UI settings metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "surface", "title", "description", "presets", "sections"],
  "properties": {
    "schema_version": {"const": 1},
    "surface": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 3, "maxLength": 80},
    "description": {"type": "string", "minLength": 20, "maxLength": 500},
    "presets": {"$ref": "#/$defs/preset_collection"},
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/section"}
    }
  },
  "$defs": {
    "plan_value": {
      "oneOf": [
        {"type": "string", "maxLength": 120},
        {"type": "integer"},
        {"type": "boolean"},
        {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 80}
        }
      ]
    },
    "preset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "town_hall",
        "label",
        "summary",
        "description",
        "compatibility",
        "source_note",
        "values"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^th[0-9]+$"},
        "town_hall": {"type": "integer", "minimum": 2, "maximum": 99},
        "label": {"type": "string", "minLength": 6, "maxLength": 40},
        "summary": {"type": "string", "minLength": 20, "maxLength": 180},
        "description": {"type": "string", "minLength": 40, "maxLength": 600},
        "compatibility": {"enum": ["script-declared", "engine-fallback"]},
        "source_note": {"type": "string", "minLength": 20, "maxLength": 300},
        "values": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/plan_value"}
        }
      }
    },
    "preset_collection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "preserved_settings", "items"],
      "properties": {
        "title": {"type": "string", "minLength": 3, "maxLength": 80},
        "description": {"type": "string", "minLength": 40, "maxLength": 500},
        "preserved_settings": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"}
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/preset"}
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "label",
        "summary",
        "description",
        "availability",
        "runtime_verified",
        "capability_ids",
        "prerequisites",
        "disabled_reason",
        "recommended",
        "warning"
      ],
      "properties": {
        "value": {"type": "string", "minLength": 1, "maxLength": 80},
        "label": {"type": "string", "minLength": 2, "maxLength": 100},
        "summary": {"type": "string", "minLength": 10, "maxLength": 180},
        "description": {"type": "string", "minLength": 30, "maxLength": 800},
        "availability": {"enum": ["available", "gated", "planned", "unsupported"]},
        "runtime_verified": {"type": "boolean"},
        "capability_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 3, "maxLength": 128}
        },
        "prerequisites": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 3, "maxLength": 200}
        },
        "disabled_reason": {"type": "string", "maxLength": 500},
        "recommended": {"type": "boolean"},
        "warning": {"type": "string", "maxLength": 500}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimum": {"type": "integer"},
        "maximum": {"type": "integer"},
        "step": {"type": "integer", "minimum": 1},
        "max_length": {"type": "integer", "minimum": 1},
        "max_items": {"type": "integer", "minimum": 1}
      }
    },
    "setting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "label",
        "summary",
        "description",
        "default",
        "required",
        "engine_binding"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
        "type": {"enum": ["select", "multi-select", "instance-select", "text", "integer", "boolean", "profile-queue"]},
        "label": {"type": "string", "minLength": 2, "maxLength": 100},
        "summary": {"type": "string", "minLength": 10, "maxLength": 180},
        "description": {"type": "string", "minLength": 30, "maxLength": 1000},
        "default": {},
        "required": {"type": "boolean"},
        "engine_binding": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)+$"},
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/option"}
        },
        "max_selected": {"type": "integer", "minimum": 1},
        "empty_state": {"type": "string", "minLength": 10, "maxLength": 300},
        "unit": {"type": "string", "minLength": 1, "maxLength": 40},
        "native_fixed_value": {},
        "native_fixed_reason": {"type": "string", "minLength": 20, "maxLength": 500},
        "validation": {"$ref": "#/$defs/validation"}
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "select"}}},
          "then": {"required": ["options"]}
        },
        {
          "if": {"properties": {"type": {"const": "integer"}}},
          "then": {"required": ["validation"]}
        },
        {
          "if": {"properties": {"type": {"enum": ["instance-select", "text", "profile-queue"]}}},
          "then": {"properties": {"default": {"type": "string"}}}
        },
        {
          "if": {"properties": {"type": {"const": "multi-select"}}},
          "then": {
            "required": ["options", "max_selected"],
            "properties": {
              "default": {
                "oneOf": [
                  {"type": "string", "minLength": 1},
                  {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {"type": "string", "minLength": 1, "maxLength": 80}
                  }
                ]
              }
            }
          },
          "else": {"not": {"required": ["max_selected"]}}
        }
      ]
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tab_label", "title", "description", "order", "settings"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "tab_label": {"type": "string", "minLength": 2, "maxLength": 10},
        "title": {"type": "string", "minLength": 2, "maxLength": 100},
        "description": {"type": "string", "minLength": 20, "maxLength": 500},
        "order": {"type": "integer", "minimum": 0},
        "settings": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/setting"}
        }
      }
    }
  }
}
