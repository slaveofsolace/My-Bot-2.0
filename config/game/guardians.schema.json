{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/my-bot-2.0/game/guardians.schema.json",
  "title": "Current Home Village Guardian catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "as_of", "guardian_count", "max_active_guardians", "guardians"],
  "properties": {
    "schema_version": {"const": 1},
    "as_of": {"type": "string", "format": "date"},
    "guardian_count": {"const": 3},
    "max_active_guardians": {"const": 1},
    "guardians": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "unlock_town_hall", "source_id", "builder_required", "unavailable_while_upgrading", "completed_level_defends_while_upgrading", "fixture_ids"],
        "properties": {
          "id": {"type": "string"},
          "label": {"type": "string"},
          "unlock_town_hall": {"const": 18},
          "source_id": {"type": "string"},
          "builder_required": {"const": true},
          "unavailable_while_upgrading": {"const": true},
          "completed_level_defends_while_upgrading": {"const": true},
          "fixture_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    }
  }
}
