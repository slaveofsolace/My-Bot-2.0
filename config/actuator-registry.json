{
  "schema_version": 1,
  "as_of": "2026-08-20",
  "scope": "Every intended tracked or untracked non-test AutoIt function that directly owns a game-input, process-control, window-control, managed-engine, or dynamic-dispatch call.",
  "policy_definitions": {
    "capability": "A closed-world implementation owns the actuator and is named by capability id; runtime evidence is still required.",
    "blocked": "Inherited or manual behavior exists but planned execution must not reach it until a closed-world route is implemented and proved.",
    "infrastructure": "The actuator is an operating-system, emulator, input-transport, recognition, or UI primitive rather than a gameplay capability.",
    "test-only": "The actuator can execute only from a tracked test entry point."
  },
  "sink_groups": {
    "game_input": [
      "Click", "ClickP", "BuildingClick", "BuildingClickP", "ClickAway", "ClickAway2",
      "PureClick", "PureClickP", "PureClickTrain", "GemClick", "GemClickP", "AttackClick", "AttackClickCSV",
      "ClickZone", "ClickR", "PureClickR", "GemClickR", "ClickDrag", "_PostMessage_ClickDrag",
      "ClickOkay", "ClickRemove", "ClickB", "ClickButton", "TrainClick", "TrainClickP",
      "_ControlClick", "ControlClick", "AndroidClick", "AndroidFastClick", "AndroidMinitouchClick",
      "AndroidSlowClick", "AndroidClickDrag", "AndroidMinitouchClickDrag", "AndroidInputSwipe", "AndroidSendText", "SendText",
      "AndroidAdbSendShellCommand", "_AndroidAdbSendShellCommand", "AndroidAdbSendMinitouchShellCommand",
      "AndroidAdbSendShellCommandScript", "AndroidAdbScript",
      "ControlSend", "Send", "MouseClick", "MouseDown", "MouseUp", "MouseWheel", "MouseMove"
    ],
    "process_and_window_control": [
      "PostMessage", "_WinAPI_PostMessage", "_WinAPI_SendMessage", "ProcessClose", "WinClose", "WinKill",
      "WinMove", "WinActivate", "WinSetState", "WinSetOnTop", "WinSetTrans", "WinSetTitle",
      "ControlCommand", "ControlFocus", "ControlMove", "ControlHide", "ControlShow",
      "Run", "RunWait", "ShellExecute", "ShellExecuteWait", "Shutdown"
    ],
    "managed_engine": ["DllCallMyBot"],
    "dynamic_dispatch": ["DynamicCall"]
  },
  "owner_fingerprint": {
    "count": 460,
    "sha256": "e783a21f2f958a9e2f83e99807c296a4cf08beb180fd08c4a73ce1d118471d2d"
  },
